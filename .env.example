# Copie este arquivo para ".env" (ou exporte as variáveis no seu shell) para
# ativar a IA opcional via Hugging Face. Se nada aqui for definido, o /chat
# responde com a mensagem estática e as perguntas prontas do front-end
# continuam funcionando normalmente, sem custo e sem cartão de crédito.

# Token gratuito gerado em https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Modelo do Inference API a ser usado. A disponibilidade de modelos no tier
# gratuito da Hugging Face muda com o tempo - confira quais estão "warm" em
# https://huggingface.co/models?inference=warm antes de trocar.
HF_MODEL=HuggingFaceH4/zephyr-7b-beta
